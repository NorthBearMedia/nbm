# ─── North Bear Pulse configuration ──────────────────────────────
# Copy this file to .env and fill in your values.

# Port the server runs on
PORT=3002

# Public URL of this app (used in emails for dashboard / report links)
# e.g. https://pulse.northbearmedia.co.uk  (no trailing slash)
APP_URL=http://localhost:3002

# Password for the admin console (you). Pick something long.
ADMIN_PASSWORD=change-me

# Timezone for schedules ("send Monday 7am" etc.)
TIMEZONE=Europe/London

# ─── Google (Analytics 4 + Search Console) ───────────────────────
# One service account connects ALL client sites. See README.md for
# the 10-minute setup. Paste EITHER the path to the JSON key file,
# OR the raw JSON itself (single line), into ONE of these:
GOOGLE_SERVICE_ACCOUNT_FILE=./data/google-service-account.json
GOOGLE_SERVICE_ACCOUNT_JSON=

# ─── Email (SMTP) ─────────────────────────────────────────────────
# Works out of the box with a Hostinger mailbox.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=reports@northbearmedia.co.uk
SMTP_PASS=your-mailbox-password
EMAIL_FROM="North Bear Media Reports <reports@northbearmedia.co.uk>"
# BCC every client report to yourself (optional, leave blank to disable)
EMAIL_BCC=info@northbearmedia.co.uk

# ─── Storage ──────────────────────────────────────────────────────
# Where the database and generated PDFs live. On Railway, attach a
# volume and point this at its mount path so data survives deploys.
DATA_DIR=./data
