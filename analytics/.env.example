# ─── North Bear Pulse configuration ──────────────────────────────
# Only ADMIN_PASSWORD is required here. Everything else can be set up
# from the browser: log in and the setup wizard walks you through email
# and Google in a few minutes (values you save there live in the
# database and override anything below).

# Password for the admin console (you). Pick something long. REQUIRED.
ADMIN_PASSWORD=change-me

# Port the server runs on
PORT=3002

# ─── Optional — all of this can be done in the setup wizard instead ──

# Public URL of this app (used in emails for dashboard links).
# The wizard fills this in automatically from your browser.
APP_URL=

# Timezone for schedules ("send Monday 7am" etc.)
TIMEZONE=Europe/London

# Google service account (connects GA4 + Search Console for all sites).
# Easiest: paste the key JSON into the setup wizard. Or set one of these:
GOOGLE_SERVICE_ACCOUNT_FILE=./data/google-service-account.json
GOOGLE_SERVICE_ACCOUNT_JSON=

# Email (SMTP) — works out of the box with a Hostinger mailbox.
# Easiest: enter these in the setup wizard instead.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
EMAIL_BCC=

# Where the database and generated PDFs live. On Railway, attach a
# volume and point this at its mount path so data survives deploys.
DATA_DIR=./data

# Set to false to disable creating North Bear Media as the first
# customer on a fresh database.
SEED_FIRST_SITE=true
