node_modules/
.env
data/
# ...but the Willis Cooper site has its own assets/data (live PHP donations
# endpoint + tracker files). The bare rule above was silently excluding it,
# which would have let a deploy delete those files from the server.
!sites/williscooper/assets/data/
*.db

# Willis Cooper build artifacts (regenerated by make-staging.mjs)
sites/williscooper-staging-build/
sites/williscooper-live-build/
sites/williscooper/williscooper-staging.zip
sites/williscooper/williscooper-live.zip
