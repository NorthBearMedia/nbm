      "args": ["scripts/hostinger-mcp.sh", "hosting"],
      "env": { "HOSTINGER_API_TOKEN": "${HOSTINGER_API_TOKEN}" }
    },
    "hostinger-domains": {
      "command": "bash",
      "args": ["scripts/hostinger-mcp.sh", "domains"],
