    "hostinger-billing": {
      "command": "bash",
      "args": ["scripts/hostinger-mcp.sh", "billing"],
      "env": { "HOSTINGER_API_TOKEN": "${HOSTINGER_API_TOKEN}" }
    },
    "hostinger-reach": {
      "command": "bash",
      "args": ["scripts/hostinger-mcp.sh", "reach"],
