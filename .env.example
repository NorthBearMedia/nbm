# ── Required ────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# Page 1
FACEBOOK_PAGE_ID=your_page_id
FACEBOOK_PAGE_ACCESS_TOKEN=your_page_token
FACEBOOK_PAGE_NAME=Spotted Derby

# Page 2 — add _3, _4... for more pages
FACEBOOK_PAGE_ID_2=your_second_page_id
FACEBOOK_PAGE_ACCESS_TOKEN_2=your_second_page_token
FACEBOOK_PAGE_NAME_2=Spotted Wirksworth

# ── Strongly recommended ────────────────────────────────────────────────────
# Locks /stats /messages /flagged /admin behind ?key=... (they return 503 while unset)
ADMIN_KEY=pick-a-long-random-string

# Enables one-tap Approve/Reject buttons in FLAG emails (needs PUBLIC_URL too)
ACTION_SECRET=pick-a-different-long-random-string
PUBLIC_URL=https://your-app.up.railway.app

# Email notifications & alerts (Resend)
RESEND_API_KEY=re_...
NOTIFICATION_EMAIL=you@example.com

# ── Optional ────────────────────────────────────────────────────────────────
# Posts only go live between these hours (timezone below); overnight
# submissions are scheduled for the next window open. Unset = post any time.
# POSTING_HOURS=7-22
# POSTING_TIMEZONE=Europe/London

# Post styling per page — must contain {text}. Unset = post the text as-is.
# FACEBOOK_PAGE_TEMPLATE=📢 Spotted Submission\n\n{text}
# FACEBOOK_PAGE_TEMPLATE_2={text}

# PORT=3000
# POLL_INTERVAL_SECONDS=60
# CONFIDENCE_THRESHOLD=0.7
# ANTHROPIC_MODEL=claude-sonnet-4-6
# DATA_DIR=./data
# LOG_DEBUG=false
# PAUSED=false
